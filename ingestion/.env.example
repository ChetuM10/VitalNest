# Copy this file to ".env" in the same folder and replace the placeholder with your real key.
# ".env" is git-ignored. Never paste the key into chat, code, or any file that is committed.
PINECONE_API_KEY=paste-your-pinecone-key-here

# Cognito (identifiers, not secrets; copy the real values into your own .env)
COGNITO_REGION=your-aws-region
COGNITO_USER_POOL_ID=your-user-pool-id
COGNITO_CLIENT_ID=your-app-client-id
